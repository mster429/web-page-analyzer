# Copy this file to .env and change what you need:
#
#     cp .env.example .env
#
# make run and docker compose both read .env. Every line is optional,
# a missing or empty setting uses the default shown here.

# address the server listens on (docker compose always uses :8080 inside the container)
HOST_PORT=:8080

# time allowed to download the page
PAGE_FETCH_TIMEOUT=10s

# time allowed for one link before it counts as timed out
SINGLE_LINK_CHECK_TIMEOUT=5s

# time allowed to check all the links of one page
TOTAL_LINK_CHECK_TIMEOUT=20s

# how many links are checked at the same time
LINK_CHECK_WORKERS=20

# how much of a page is read, in megabytes
PAGE_SIZE_LIMIT_MB=5

# serve go profiling data at /debug/pprof/
ENABLE_PPROF=true

# debug, info, warn or error
LOG_LEVEL=info
